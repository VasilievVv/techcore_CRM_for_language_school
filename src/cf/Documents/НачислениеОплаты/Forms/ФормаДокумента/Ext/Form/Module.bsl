#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура РасчитатьНачисления(Команда) 
	
	ОчиститьСообщения();
	
	Если ЗначениеЗаполнено(Объект.ПериодНачисления) Тогда
		
		ДатаНачала 		= НачалоМесяца(Объект.ПериодНачисления);
		ДатаОкончания 	= КонецМесяца(Объект.ПериодНачисления);
		
		Объект.Начисления.Очистить();
		
		РасчитатьНачисленияНаСервере(ДатаНачала, ДатаОкончания);
		
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните период начиления!");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РасчитатьНачисленияНаСервере(ДатаНачала, ДатаОкончания)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныСкидкиКлиентовСрезПоследних.Договор КАК Договор,
		|	ЦеныСкидкиКлиентовСрезПоследних.Плательщик КАК Клиент,
		|	ЦеныСкидкиКлиентовСрезПоследних.Ученик КАК Ученик,
		|	ЦеныСкидкиКлиентовСрезПоследних.ЦенаСУчетомСкидки КАК ЦенаЗаЗанятие,
		|	0 КАК ЗанятийПлан,
		|	ЕСТЬNULL(ВзаиморасчетыСКлиентамиОстатки.СуммаОстаток, 0) КАК СуммаОстаток,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВзаиморасчетыСКлиентамиОстатки.СуммаОстаток, 0) > 0
		|			ТОГДА ЕСТЬNULL(ВзаиморасчетыСКлиентамиОстатки.СуммаОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Долг,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВзаиморасчетыСКлиентамиОстатки.СуммаОстаток, 0) < 0
		|			ТОГДА ЕСТЬNULL(ВзаиморасчетыСКлиентамиОстатки.СуммаОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Переплата
		|ИЗ
		|	РегистрСведений.ЦеныСкидкиКлиентов.СрезПоследних(
		|			,
		|			Договор.Проведен
		|				И Договор.СтатусДоговора = &СтатусДоговора) КАК ЦеныСкидкиКлиентовСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКлиентами.Остатки КАК ВзаиморасчетыСКлиентамиОстатки
		|		ПО ЦеныСкидкиКлиентовСрезПоследних.Договор = ВзаиморасчетыСКлиентамиОстатки.Договор";
	
	Запрос.УстановитьПараметр("СтатусДоговора", Перечисления.СтатусыДоговора.Действующий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Объект.Начисления.Загрузить(РезультатЗапроса.Выгрузить());	
	
	Для Каждого Начисление Из Объект.Начисления Цикл
		
		// Временно для проверки механизма, да запрос в цикле
		мДней = Начисление.Договор.ГрафикОказанияУслуг.ВыгрузитьКолонку("ДеньНедели");
		
		мНомеровДней = Новый Массив;
		
		Для Каждого День Из мДней Цикл
			мНомеровДней.Добавить(РасчетЗанятийСервер.НомерДняНедели(День));			
		КонецЦикла;
		
		Начисление.ЗанятийПлан = РасчетЗанятийСервер.КоличествоАкадемическихЧасов(ДатаНачала, ДатаОкончания, мНомеровДней);  
		
		Начисление.СуммаНачисленно = Начисление.ЗанятийПлан * Начисление.ЦенаЗаЗанятие;
		
		Начисление.ИтогоКОплате = Начисление.СуммаНачисленно + Начисление.Долг + Начисление.Переплата;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
