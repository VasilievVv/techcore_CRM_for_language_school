Процедура РасчитатьКоличествоАкадемическихЧасов()

КонецПроцедуры

&НаСервереБезКонтекста
Функция БазоваяСтоимостьЗанятия(Знач Группа)
		
	БазоваяСтоимостьЗанятия = 0;
	
	ДанныеГруппы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Группа, "ВозрастнаяГруппа, ФормаЗанятий");	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныОбученияСрезПоследних.ЦенаЗаЗанятие КАК ЦенаЗаЗанятие
		|ИЗ
		|	РегистрСведений.ЦеныОбучения.СрезПоследних(
		|			,
		|			ВозрастнаяГруппа = &ВозрастнаяГруппа
		|				И ФормаЗанятий = &ФормаЗанятий) КАК ЦеныОбученияСрезПоследних";
	
	Запрос.УстановитьПараметр("ВозрастнаяГруппа", ДанныеГруппы.ВозрастнаяГруппа);
	Запрос.УстановитьПараметр("ФормаЗанятий", ДанныеГруппы.ФормаЗанятий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		БазоваяСтоимостьЗанятия = Выборка.ЦенаЗаЗанятие;
	КонецЕсли;
	
	Возврат БазоваяСтоимостьЗанятия;
	
КонецФункции

&НаКлиенте
Процедура РасчитатьИтоговуюСтоимостьЗанятия() 
	
	Если НЕ ЗначениеЗаполнено(БазоваяСтоимость) Тогда
		Возврат;	
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.СкидкаФиксированная) Тогда
		Объект.ИтоговаяСтоимостьЗанятия = БазоваяСтоимость - Объект.СкидкаФиксированная;
    Иначе
		Объект.ИтоговаяСтоимостьЗанятия = БазоваяСтоимость;																									
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура РасторгнутьНаСервере()
	
	НачатьТранзакцию();
	
	Попытка	// Надо разбить на несколько
		
		// Клиент
		ОбъектКлиент = Объект.Плательщик.ПолучитьОбъект();
		
		СтрокаДоговора = ОбъектКлиент.Договора.Найти(Объект.Ссылка, "Договор");
		СтрокаДоговора.СтатусДоговора = Перечисления.СтатусыДоговора.Расторгнут;
		
		ОбъектКлиент.ИзменитьСтатус();
		
		ОбъектКлиент.Записать();
			
		// У ученика меняем статус
		ОбъектУченик = Объект.Ученик.ПолучитьОбъект();
		
		ОбъектУченик.Статус = Перечисления.СтатусыУченика.ПрекратилОбучение;
		
		ОбъектУченик.Записать();
		
		// Убираем Ученика из группы
		ОбъектГруппа = Объект.Группа.ПолучитьОбъект();
		
		СтрокаУченикВГруппе = ОбъектГруппа.СоставГруппы.Найти(Объект.Ученик, "Ученик");
		
		Если СтрокаУченикВГруппе <> Неопределено Тогда
			ИндексСтроки = ОбъектГруппа.СоставГруппы.Индекс(СтрокаУченикВГруппе); 
			ОбъектГруппа.СоставГруппы.Удалить(ИндексСтроки);		
		КонецЕсли;
			
		ОбъектГруппа.Записать();
		
		// Обновляем статус договора
		Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Расторгнут;
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

#КонецОбласти
