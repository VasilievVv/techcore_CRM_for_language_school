#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Программа) И  ЗначениеЗаполнено(Объект.ФормаЗанятий) Тогда
		БазоваяСтоимость = БазоваяСтоимостьЗанятия(Объект.Программа, Объект.ФормаЗанятий);	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПрограммаПриИзменении(Элемент)
		
	Если ЗначениеЗаполнено(Объект.Программа) И  ЗначениеЗаполнено(Объект.ФормаЗанятий) Тогда
		БазоваяСтоимость = БазоваяСтоимостьЗанятия(Объект.Программа, Объект.ФормаЗанятий);	
	КонецЕсли;
	
	РасчитатьИтоговуюСтоимостьЗанятия();
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаЗанятийПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Программа) И  ЗначениеЗаполнено(Объект.ФормаЗанятий) Тогда
		БазоваяСтоимость = БазоваяСтоимостьЗанятия(Объект.Программа, Объект.ФормаЗанятий);	
	КонецЕсли;
	
	РасчитатьИтоговуюСтоимостьЗанятия();

КонецПроцедуры

&НаКлиенте
Процедура СкидкаФиксированнаяПриИзменении(Элемент)
	РасчитатьИтоговуюСтоимостьЗанятия();
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	Если Объект.ГрафикОказанияУслуг.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала заполните график оказания услуг!");
		Объект.ДатаНачала = "00010101";
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		
		ДниПосещений = Новый Массив;
		
		Для Каждого Строка Из Объект.ГрафикОказанияУслуг Цикл
			ДниПосещений.Добавить(Строка.ДеньНедели);			
		КонецЦикла;
		
		Объект.КоличествоАкадемическихЧасов = КоличествоАкадемическихЧасов_Сервер(Объект.ДатаНачала, Объект.ДатаОкончания, ДниПосещений);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	Если Объект.ГрафикОказанияУслуг.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала заполните график оказания услуг!");
		Объект.ДатаНачала = "00010101";
		Возврат;
	КонецЕсли;
	
		ДниПосещений = Новый Массив;
		
		Для Каждого Строка Из Объект.ГрафикОказанияУслуг Цикл
			ДниПосещений.Добавить(Строка.ДеньНедели);			
		КонецЦикла;

	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Объект.КоличествоАкадемическихЧасов = КоличествоАкадемическихЧасов_Сервер(Объект.ДатаНачала, Объект.ДатаОкончания, ДниПосещений);	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Расторгнуть(Команда)
	
	Если Объект.СтатусДоговора = ПредопределенноеЗначение("Перечисление.СтатусыДоговора.Действующий") 
		ИЛИ	Объект.СтатусДоговора = ПредопределенноеЗначение("Перечисление.СтатусыДоговора.Приостановлен")Тогда 
		
		РасторгнутьНаСервере();
		
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя расторгнуть не действующий договор");
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция КоличествоАкадемическихЧасов_Сервер(ДатаНачала, ДатаОкончания, ДниПосещений)
	
	НомераДней = Новый Массив;
	
	Для Каждого День Из ДниПосещений Цикл
		НомераДней.Добавить(РасчетЗанятийСервер.НомерДняНедели(День));		
	КонецЦикла;
	
	Возврат РасчетЗанятийСервер.КоличествоАкадемическихЧасов(ДатаНачала, ДатаОкончания, НомераДней);
	
КонецФункции

&НаСервереБезКонтекста
Функция БазоваяСтоимостьЗанятия(Знач ВозрастнаяГруппа, Знач ФормаЗанятий)
		
	БазоваяСтоимостьЗанятия = 0;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныОбученияСрезПоследних.ЦенаЗаЗанятие КАК ЦенаЗаЗанятие
		|ИЗ
		|	РегистрСведений.ЦеныОбучения.СрезПоследних(
		|			,
		|			ВозрастнаяГруппа = &ВозрастнаяГруппа
		|				И ФормаЗанятий = &ФормаЗанятий) КАК ЦеныОбученияСрезПоследних";
	
	Запрос.УстановитьПараметр("ВозрастнаяГруппа", ВозрастнаяГруппа);
	Запрос.УстановитьПараметр("ФормаЗанятий", ФормаЗанятий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		БазоваяСтоимостьЗанятия = Выборка.ЦенаЗаЗанятие;
	КонецЕсли;
	
	Возврат БазоваяСтоимостьЗанятия;
	
КонецФункции

&НаКлиенте
Процедура РасчитатьИтоговуюСтоимостьЗанятия() 
	
	Если НЕ ЗначениеЗаполнено(БазоваяСтоимость) Тогда
		Возврат;	
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.СкидкаФиксированная) Тогда
		Объект.ИтоговаяСтоимостьЗанятия = БазоваяСтоимость - Объект.СкидкаФиксированная;
    Иначе
		Объект.ИтоговаяСтоимостьЗанятия = БазоваяСтоимость;																									
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура РасторгнутьНаСервере()
	
	НачатьТранзакцию();
	
	Попытка			
		// Клиент
		ОбъектКлиент = Объект.Плательщик.ПолучитьОбъект();
		
		СтрокаДоговора = ОбъектКлиент.Договора.Найти(Объект.Ссылка, "Договор");
		СтрокаДоговора.СтатусДоговора = Перечисления.СтатусыДоговора.Расторгнут;
		
		ОбъектКлиент.ИзменитьСтатус();
		
		ОбъектКлиент.Записать();
			
		// У ученика меняем статус
		ОбъектУченик = Объект.Ученик.ПолучитьОбъект();
		
		ОбъектУченик.Статус = Перечисления.СтатусыУченика.ПрекратилОбучение;
		
		ОбъектУченик.Записать();
		
		// Убираем Ученика из групп
		
		Для Каждого Строка Из Объект.ГрафикОказанияУслуг Цикл
	
			ОбъектГруппа = Строка.Группа.ПолучитьОбъект();
			
			СтрокаУченикВГруппе = ОбъектГруппа.СоставГруппы.Найти(Объект.Ученик, "Ученик");
			
			Если СтрокаУченикВГруппе <> Неопределено Тогда
				ИндексСтроки = ОбъектГруппа.СоставГруппы.Индекс(СтрокаУченикВГруппе); 
				ОбъектГруппа.СоставГруппы.Удалить(ИндексСтроки);		
			КонецЕсли;
				
			ОбъектГруппа.Записать();
		
		КонецЦикла;
		
		// Обновляем статус договора
		Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Расторгнут;
		
	ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;
	
КонецПроцедуры 

#КонецОбласти
