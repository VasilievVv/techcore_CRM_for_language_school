#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Группа) Тогда
		БазоваяСтоимость = БазоваяСтоимостьЗанятия(Объект.Группа);	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ГруппаПриИзменении(Элемент)
	
	БазоваяСтоимость = БазоваяСтоимостьЗанятия(Объект.Группа);
	РасчитатьИтоговуюСтоимостьЗанятия();
	
КонецПроцедуры

&НаКлиенте
Процедура СкидкаФиксированнаяПриИзменении(Элемент)
	РасчитатьИтоговуюСтоимостьЗанятия();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Расторгнуть(Команда)
	
	Если Объект.СтатусДоговора = ПредопределенноеЗначение("Перечисление.СтатусыДоговора.Действующий") 
		ИЛИ	Объект.СтатусДоговора = ПредопределенноеЗначение("Перечисление.СтатусыДоговора.Приостановлен")Тогда 
		
		РасторгнутьНаСервере();
		
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя расторгнуть не действующий договор");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

