#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//{{__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Клиенты") Тогда
		
		// Заполнение шапки
		Плательщик = ДанныеЗаполнения;
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Ученики.Ссылка КАК Ученик
			|ИЗ
			|	Справочник.Ученики КАК Ученики
			|ГДЕ
			|	Ученики.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец", ДанныеЗаполнения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Ученик = Выборка.Ученик;
			
		КонецЕсли;
		
	КонецЕсли; 
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ

	// регистр ЦеныСкидкиКлиентов	
	Движения.ЦеныСкидкиКлиентов.Записывать = Истина; 

	Движение = Движения.ЦеныСкидкиКлиентов.Добавить();
	
	Движение.Период 			= Дата;
	Движение.Плательщик 		= Плательщик;
	Движение.Ученик 			= Ученик;
	Движение.Направление 		= Направление;
	Движение.Договор			= Ссылка;
	Движение.ЦенаСУчетомСкидки 	= ИтоговаяСтоимостьЗанятия;
	Движение.РазмерСкидки 		= СкидкаФиксированная; 
		
	// Добавляем договор плательщику
	ОбъектПлательщик = Плательщик.ПолучитьОбъект();
		
	СрокаДоговораПлательщика = ОбъектПлательщик.Договора.Найти(Ссылка, "Договор");
	
	Если СрокаДоговораПлательщика = Неопределено Тогда
	
		НовыйДоговорПлательщика = ОбъектПлательщик.Договора.Добавить();
		
		НовыйДоговорПлательщика.Договор 		= Ссылка;
		НовыйДоговорПлательщика.Ученик 			= Ученик;
		НовыйДоговорПлательщика.СтатусДоговора 	= Перечисления.СтатусыДоговора.Действующий;
		
		ОбъектПлательщик.ИзменитьСтатус();
	
	КонецЕсли;
	
	ОбъектПлательщик.Записать();
	
	// Добавляем договор ученику и меняем статус
	ОбъектУченик = Ученик.ПолучитьОбъект();
	
	ОбъектУченик.Договор 			= Ссылка;
	ОбъектУченик.Статус 			= Перечисления.СтатусыУченика.Активный;
	
	ОбъектУченик.Записать();
	
	// Добавляем Ученика в группу
	
	Для Каждого Строка Из ГрафикОказанияУслуг Цикл
		
	ОбъектГруппа = Строка.Группа.ПолучитьОбъект();
	
	СтрокаУченикВГруппе = ОбъектГруппа.СоставГруппы.Найти(Ученик, "Ученик");
	
	Если СтрокаУченикВГруппе = Неопределено Тогда

		НовыйУченикВГруппе = ОбъектГруппа.СоставГруппы.Добавить();
		
		НовыйУченикВГруппе.Ученик 				= Ученик;
		НовыйУченикВГруппе.ДатаНачалаЗанятий 	= ДатаНачала;
	
	КонецЕсли;
	
	ОбъектГруппа.Записать();
	
	КонецЦикла;
	
	// Обновляем статус договора
	СтатусДоговора = Перечисления.СтатусыДоговора.Действующий; 
	
	Записать();

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ) 
	
	// Клиент
	ОбъектКлиент = Плательщик.ПолучитьОбъект();
	
	ОбъектКлиент.УдалитьДоговор(Ссылка);
	ОбъектКлиент.ИзменитьСтатус();		
	
	ОбъектКлиент.Записать();
	
	// Убираем договор у ученика и меняем статус
	ОбъектУченик = Ученик.ПолучитьОбъект();
	
	ОбъектУченик.Договор 			= Документы.ДоговорОбучения.ПустаяСсылка();
	ОбъектУченик.Статус 			= Перечисления.СтатусыУченика.Потенциальный;
	ОбъектУченик.ТекущаяГруппа 		= Справочники.Группы.ПустаяСсылка();
	
	ОбъектУченик.Записать();
	
	// Убираем Ученика из группы
	ОбъектГруппа = Программа.ПолучитьОбъект();
	
	СтрокаУченикВГруппе = ОбъектГруппа.СоставГруппы.Найти(Ученик, "Ученик");
	
	Если СтрокаУченикВГруппе <> Неопределено Тогда
		ИндексСтроки = ОбъектГруппа.СоставГруппы.Индекс(СтрокаУченикВГруппе); 
		ОбъектГруппа.СоставГруппы.Удалить(ИндексСтроки);		
	КонецЕсли;
		
	ОбъектГруппа.Записать();
	
	// Обновляем статус договора
	СтатусДоговора = Перечисления.СтатусыДоговора.Проект; 
	
	Записать();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ИндексРеквизита = ПроверяемыеРеквизиты.Найти("ГрафикОказанияУслуг");
	Если ИндексРеквизита <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ИндексРеквизита);
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ГрафикОказанияУслуг.Количество() = 0 Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Не заполнен график оказания услуг!");
		Возврат;
	КонецЕсли;
	
	Дни = Новый Массив;
	
	Для Каждого Строка Из ГрафикОказанияУслуг Цикл
		
		// Только будние дни
		Если Строка.ДеньНедели = Перечисления.ДниНедели.Суббота
            ИЛИ Строка.ДеньНедели = Перечисления.ДниНедели.Воскресенье Тогда
            Отказ = Истина;
            ОбщегоНазначения.СообщитьПользователю("Занятия только с понедельника по пятницу.");
            Возврат;
		КонецЕсли;
		
		// Проверка дублей дней
        Если Дни.Найти(Строка.ДеньНедели) <> Неопределено Тогда
            Отказ = Истина;
            ОбщегоНазначения.СообщитьПользователю("День недели повторяются в графике.");
            Возврат;
        КонецЕсли;
        Дни.Добавить(Строка.ДеньНедели);
		        		
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли
