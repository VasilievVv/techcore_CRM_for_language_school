		Движение.Ученик = ТекСтрокаПлатежи.Ученик;
		Движение.Договор = ТекСтрокаПлатежи.Договор;
		Движение.Сумма = ТекСтрокаПлатежи.СуммаПлатежа;
	КонецЦикла;
	
	// регистр Платежи Приход
	Движения.Платежи.Записывать = Истина;
	Для Каждого ТекСтрокаПлатежи Из Платежи Цикл
		Движение = Движения.Платежи.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Клиент = ТекСтрокаПлатежи.Клиент;
		Движение.Ученик = ТекСтрокаПлатежи.Ученик;
		Движение.Сумма = ТекСтрокаПлатежи.СуммаПлатежа;
	КонецЦикла;

