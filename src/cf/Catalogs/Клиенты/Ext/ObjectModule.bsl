#Область ПрограммныйИнтерфейс

Процедура УдалитьДоговор(Договор) Экспорт 
	
	СтрокаДоговораПлательщика = Договора.Найти(Договор, "Договор");
		
	Если СтрокаДоговораПлательщика <> Неопределено Тогда
		ИндексСтроки = Договора.Индекс(СтрокаДоговораПлательщика); 
		Договора.Удалить(ИндексСтроки);		
	КонецЕсли; 
		
КонецПроцедуры 

Процедура ИзменитьСтатус() Экспорт
	
	ЕстьАктивныйДоговор = Ложь;
	
	Если Договора.Количество() = 0 Тогда
		Статус = Перечисления.СтатусыКлиента.Потенциальный;
	Иначе
		Для Каждого СтрокаДоговора Из Договора Цикл
			Если СтрокаДоговора.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий
				ИЛИ СтрокаДоговора.СтатусДоговора = Перечисления.СтатусыДоговора.Приостановлен Тогда
				
				ЕстьАктивныйДоговор = Истина;
				
			КонецЕсли;	
		КонецЦикла;	
	
		Если ЕстьАктивныйДоговор Тогда
			Статус = Перечисления.СтатусыКлиента.Активный;
		Иначе
			Статус = Перечисления.СтатусыКлиента.Бывший;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

