#Область ПрограммныйИнтерфейс

Функция РабочииДниСДатыПОДату(ДатаНачала, ДатаОкончания) Экспорт
	
	мДней = Новый Массив;
	
	мДней.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий);
	мДней.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);

	
	ВидыРабочихДней = Новый ФиксированныйМассив(мДней);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПроизводственногоКалендаря.Дата КАК Дата
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ДанныеПроизводственногоКалендаря.ВидДня В(&ВидыРабочихДней)";
	
	Запрос.УстановитьПараметр("ВидыРабочихДней", ВидыРабочихДней);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Возврат ОбщегоНазначения.ВыгрузитьКолонку(РезультатЗапроса.Выгрузить(), "Дата", Истина)
	
КонецФункции

Функция КоличествоАкадемическихЧасов(ДатаНачала, ДатаОкончания, МассивНомеровДней) Экспорт
	
	КоличествоЧасов = 0;
	
	ОбщиеРабочиеДни = РабочииДниСДатыПОДату(ДатаНачала, ДатаОкончания); 
	
	ОпределяемаяДата = НачалоДня(ДатаНачала);
	
	Пока ОпределяемаяДата <= НачалоДня(ДатаОкончания) Цикл
		
		Если ОбщиеРабочиеДни.Найти(ОпределяемаяДата) <> Неопределено Тогда
			Если МассивНомеровДней.Найти(ДеньНедели(ОпределяемаяДата)) <> Неопределено Тогда
				КоличествоЧасов = КоличествоЧасов + 1;	
			КонецЕсли;
		КонецЕсли;
		
		ОпределяемаяДата = ОпределяемаяДата + 86400;	
		
	КонецЦикла;
	
	Возврат КоличествоЧасов;
		
КонецФункции 

Функция НомерДняНедели(ЗначениеПеречисления) Экспорт
    
    Если ЗначениеПеречисления = Перечисления.ДниНедели.Понедельник Тогда Возврат 1;
    ИначеЕсли ЗначениеПеречисления = Перечисления.ДниНедели.Вторник Тогда Возврат 2;
    ИначеЕсли ЗначениеПеречисления = Перечисления.ДниНедели.Среда Тогда Возврат 3;
    ИначеЕсли ЗначениеПеречисления = Перечисления.ДниНедели.Четверг Тогда Возврат 4;
    ИначеЕсли ЗначениеПеречисления = Перечисления.ДниНедели.Пятница Тогда Возврат 5;
    ИначеЕсли ЗначениеПеречисления = Перечисления.ДниНедели.Суббота Тогда Возврат 6;
    ИначеЕсли ЗначениеПеречисления = Перечисления.ДниНедели.Воскресенье Тогда Возврат 7;
    КонецЕсли;
    
    Возврат 0;
    
КонецФункции


